# HealthPoint Environment Variables Template
# Copy this file to backend/.env and configure your real credentials.
# Never commit backend/.env or real secrets to version control.

ENV=development
JWT_SECRET_KEY=
OTP_HMAC_SECRET=
MONGO_URI=
DB_NAME=healthpoint
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000,https://health-point-tau.vercel.app

# Gmail SMTP Configuration (Required for Email OTP Verification)
SMTP_EMAIL=
SMTP_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Optional Google Maps API Key (Backend Only)
GOOGLE_MAPS_API_KEY=

# OpenRouter AI Inference Provider Configuration (Non-Gemini free-tier models only: must end with :free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_FALLBACK_MODELS=mistralai/mistral-small-3.1-24b-instruct:free,meta-llama/llama-3.1-8b-instruct:free,qwen/qwen-2.5-72b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_TIMEOUT=30
AI_MAX_RETRIES=2
