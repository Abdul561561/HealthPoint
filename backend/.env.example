# HealthPoint Environment Variables Template
JWT_SECRET_KEY=healthpoint_super_secret_key_12345!@#
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?appName=Cluster0
DB_NAME=healthpoint
GOOGLE_MAPS_API_KEY=AIzaSy...

# OpenRouter AI Inference Provider Configuration
# Set your OpenRouter API key below (get free key at https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_FALLBACK_MODELS=google/gemini-2.0-flash-exp:free,mistralai/mistral-small-3.1-24b-instruct:free,meta-llama/llama-3.1-8b-instruct:free,qwen/qwen-2.5-72b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_TIMEOUT=30
AI_MAX_RETRIES=2
