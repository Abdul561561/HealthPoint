# HealthPoint Environment Variables Template
# Copy this file to backend/.env and configure your real credentials.
# Never commit backend/.env or real secrets to version control.

ENV=development
JWT_SECRET_KEY=
OTP_HMAC_SECRET=
MONGO_URI=
DB_NAME=healthpoint
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000,https://health-point-tau.vercel.app

# Gmail SMTP Configuration (Required for Email OTP Verification)
SMTP_EMAIL=
SMTP_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# OpenStreetMap Discovery Provider (Configurable, no API key required)
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
NOMINATIM_API_URL=https://nominatim.openstreetmap.org/search

# USDA FoodData Central API Key (Optional - uses DEMO_KEY fallback if unset)
USDA_API_KEY=

# Optional Connected Health OAuth Credentials (leave empty unless registering apps; never fakes Connected status)
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
GARMIN_CONSUMER_KEY=
GARMIN_CONSUMER_SECRET=

# Optional Emergency SOS SMS Delivery Provider (none | twilio | webhook)
# Leave as 'none' unless a real SMS gateway is configured; frontend provides mobile SMS composer fallback safely.
SMS_PROVIDER=none
SMS_TIMEOUT_SECONDS=10
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_AUTH_TOKEN=
SMS_WEBHOOK_SECRET=

# Google Gemini AI Configuration (Backend Only - Never expose to frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT=30
AI_MAX_RETRIES=2
